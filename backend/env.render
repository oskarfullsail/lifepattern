# Production environment variables for Render.com
ENVIRONMENT=production
PORT=8080

# Database configuration (will be set by Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifepattern

# JWT configuration (will be generated by Render)
JWT_SECRET=your-jwt-secret-here

# CORS configuration for production
CORS_ORIGIN=https://lifepattern-ai-dc5fe.web.app

# Logging
LOG_LEVEL=info 