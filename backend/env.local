# Local Development Environment Configuration

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/lifepattern?sslmode=disable

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# Authentication Configuration
JWT_SECRET_KEY=local-dev-secret-key-change-in-production
JWT_ISSUER=lifepattern
JWT_AUDIENCE=lifepattern-users
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=720h

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LifePattern
WEBAUTHN_RP_ORIGIN=http://localhost:8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:3000,https://lifepattern-ai-dc5fe.web.app

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m

# Challenge and Token Expiry
CHALLENGE_EXPIRY=5m
LINK_TOKEN_EXPIRY=10m 