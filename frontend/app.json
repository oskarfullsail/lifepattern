{
  "expo": {
    "name": "LifePattern AI",
    "slug": "lifepattern-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifepattern.ai",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSHealthShareUsageDescription": "LifePattern needs access to your health data to provide personalized insights and recommendations.",
        "NSHealthUpdateUsageDescription": "LifePattern needs to update your health data to track your progress and sync with other devices.",
        "NSLocationWhenInUseUsageDescription": "LifePattern uses location data to provide context-aware recommendations.",
        "NSMotionUsageDescription": "LifePattern uses motion data to track your activity levels and provide personalized insights.",
        "NSCameraUsageDescription": "LifePattern uses camera access for QR code scanning during device linking.",
        "NSMicrophoneUsageDescription": "LifePattern uses microphone access for voice input and health monitoring.",
        "UIBackgroundModes": [
          "health-kit",
          "location",
          "background-fetch",
          "remote-notification",
          "health-kit",
          "location",
          "background-fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [
          "health-records",
          "health-records"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lifepattern.ai",
      "versionCode": 1,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "DETECT_SCREEN_CAPTURE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "lifepattern"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "webpack",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lifepattern-ai",
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "6a5e526c-7cf1-4d52-8e71-c8e1fe22c92a"
      }
    }
  }
}
