    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "expo": "^52.0.47",
    "expo-background-fetch": "~13.0.6",
    "expo-build-properties": "~0.13.3",
    "expo-device": "~7.0.3",
