{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:web:production": "expo export --platform web --clear",
    "deploy": "npm run build:web:production && cp public/privacy-policy.html dist/ && firebase deploy --only hosting",
